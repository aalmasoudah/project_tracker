# Local development only. Copy to .env and replace values as needed.
DJANGO_SETTINGS_MODULE=config.settings.development
DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:5432/tracker
TEST_DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:5432/tracker_test
SECRET_KEY=django-insecure-local-development-only
DEFAULT_LANGUAGE=ar
TIME_ZONE=Asia/Riyadh
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_JSON_LOGS=true
APP_BASE_URL=http://127.0.0.1:8000
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
DEFAULT_FROM_EMAIL=tracker@example.test
# Production SMTP:
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# Production private object storage:
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
