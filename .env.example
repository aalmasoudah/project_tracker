# Local development only. Copy to .env and replace values as needed.
DJANGO_SETTINGS_MODULE=config.settings.development
DEPLOYMENT_ENVIRONMENT=development
DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:5432/tracker
TEST_DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:5432/tracker_test
SECRET_KEY=django-insecure-local-development-only
DEFAULT_LANGUAGE=ar
TIME_ZONE=Asia/Riyadh
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],host.docker.internal
DJANGO_JSON_LOGS=true
APP_BASE_URL=http://127.0.0.1:8000
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
DEFAULT_FROM_EMAIL=tracker@example.test
# AI project briefings are disabled by default. Never commit a real key.
AI_BRIEFING_ENABLED=false
AI_BRIEFING_PROVIDER=disabled
AI_BRIEFING_MODEL=openai/gpt-oss-120b
AI_BRIEFING_REASONING_EFFORT=high
AI_BRIEFING_TIMEOUT_SECONDS=45
GROQ_RATE_LIMITER_ENABLED=true
GROQ_RATE_LIMIT_RPM=30
GROQ_RATE_LIMIT_RPD=1000
GROQ_RATE_LIMIT_TPM=8000
GROQ_RATE_LIMIT_TPD=200000
GROQ_RATE_LIMIT_TOKEN_RESERVE=256
GROQ_RATE_LIMIT_MIN_OUTPUT_TOKENS=512
GROQ_RATE_LIMIT_WINDOW_SECONDS=60
# Local development only. Keep LM Studio bound to loopback; never expose port 1234.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL_CODE=qwen/qwen3.5-9b
LM_STUDIO_MODEL_ID=qwen/qwen3.5-9b
LM_STUDIO_REASONING_EFFORT=none
LM_STUDIO_FALLBACK_ENABLED=false
LM_STUDIO_TIMEOUT_SECONDS=180
LM_STUDIO_CONTEXT_LENGTH=32768
LM_STUDIO_CONTEXT_TOKEN_RESERVE=512
# Set only when LM Studio server authentication is enabled.
# LM_STUDIO_API_TOKEN=
AI_BRIEFING_MAX_OUTPUT_TOKENS=7950
AI_BRIEFING_MAX_EVIDENCE=200
AI_BRIEFING_DAILY_LIMIT=100
AI_BRIEFING_STALE_MINUTES=15
PROJECT_AGENT_ENABLED=false
PROJECT_AGENT_PROVIDER=disabled
PROJECT_AGENT_DEFAULT_MODEL=openai/gpt-oss-120b
PROJECT_AGENT_REASONING_EFFORT=high
PROJECT_AGENT_TIMEOUT_SECONDS=45
PROJECT_AGENT_MAX_OUTPUT_TOKENS=7950
PROJECT_AGENT_MAX_TOTAL_TOKENS=50000
PROJECT_AGENT_MAX_STEPS=8
PROJECT_AGENT_MAX_SECONDS=600
PROJECT_AGENT_DAILY_LIMIT=100
PROJECT_AGENT_MAX_CONTEXT_CHARS=500
PROJECT_AGENT_MAX_TOOL_RESULT_BYTES=32768
PROJECT_AGENT_MAX_TOOL_RECORDS=50
PROJECT_AGENT_MAX_MEMORIES=5
PROJECT_AGENT_STALE_MINUTES=15
PROJECT_AGENT_PROPOSAL_TTL_HOURS=72
PROJECT_AGENT_N8N_SIGNING_SECRET=
PROJECT_AGENT_N8N_ENABLED=false
PROJECT_AGENT_N8N_SIGNATURE_TTL_SECONDS=300
# GROQ_API_KEY=
# CEO Telegram/n8n reports are disabled by default. Never commit real values.
EXECUTIVE_BOT_ENABLED=false
EXECUTIVE_ASSISTANT_ENABLED=false
EXECUTIVE_ASSISTANT_DAILY_LIMIT=100
EXECUTIVE_ASSISTANT_EVIDENCE_LIMIT=40
EXECUTIVE_ASSISTANT_MAX_OUTPUT_TOKENS=7950
EXECUTIVE_ASSISTANT_STALE_MINUTES=15
# EXECUTIVE_BOT_CEO_USERNAME=
# EXECUTIVE_BOT_TELEGRAM_CHAT_ID=
# EXECUTIVE_BOT_SIGNING_SECRET=
EXECUTIVE_BOT_SIGNATURE_TTL_SECONDS=300
EXECUTIVE_BOT_DOWNLOAD_TTL_SECONDS=600
EXECUTIVE_BOT_MAX_BODY_BYTES=8192
EXECUTIVE_BOT_REPORT_MAX_ROWS=500
EXECUTIVE_BOT_DAILY_LIMIT=100
EXECUTIVE_BOT_ALERT_BATCH_SIZE=20
EXECUTIVE_BOT_ALERT_LEASE_SECONDS=300
EXECUTIVE_BOT_STALE_MINUTES=15
# Production SMTP:
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# Production private object storage:
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
