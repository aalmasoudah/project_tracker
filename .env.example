# Local development only. Copy to .env and replace values as needed.
DJANGO_SETTINGS_MODULE=config.settings.development
DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:5432/tracker
TEST_DATABASE_URL=postgresql://tracker:tracker@127.0.0.1:5432/tracker_test
SECRET_KEY=django-insecure-local-development-only
DEFAULT_LANGUAGE=en
TIME_ZONE=UTC
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_JSON_LOGS=true
