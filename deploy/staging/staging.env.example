# Copy this file outside the repository into your deployment secret manager.
# Never commit populated values. Staging must contain fictional/anonymized data only.
DJANGO_SETTINGS_MODULE=config.settings.staging
DEPLOYMENT_ENVIRONMENT=staging
SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
ALLOWED_HOSTS=staging.example.com
CSRF_TRUSTED_ORIGINS=https://staging.example.com
APP_BASE_URL=https://staging.example.com
TRUST_X_FORWARDED_PROTO=true
DEFAULT_LANGUAGE=ar
TIME_ZONE=Asia/Riyadh
DJANGO_JSON_LOGS=true

DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/replace-database?sslmode=require
CELERY_BROKER_URL=rediss://replace-user:replace-password@replace-host:6379/0

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-user
EMAIL_HOST_PASSWORD=replace-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@staging.example.com

AWS_STORAGE_BUCKET_NAME=replace-private-staging-bucket
AWS_ACCESS_KEY_ID=replace-access-key
AWS_SECRET_ACCESS_KEY=replace-secret-key
AWS_S3_ENDPOINT_URL=https://s3.example.com
AWS_S3_REGION_NAME=replace-region

# Enable each integration only after its separate staging runbook passes.
AI_BRIEFING_ENABLED=false
AI_BRIEFING_PROVIDER=disabled
AI_BRIEFING_MODEL=openai/gpt-oss-120b
AI_BRIEFING_REASONING_EFFORT=medium
AI_BRIEFING_TIMEOUT_SECONDS=45
AI_BRIEFING_MAX_OUTPUT_TOKENS=4096
AI_BRIEFING_MAX_EVIDENCE=200
AI_BRIEFING_DAILY_LIMIT=20
AI_BRIEFING_STALE_MINUTES=15
# GROQ_API_KEY belongs only in the separate worker secret environment.

EXECUTIVE_BOT_ENABLED=false
EXECUTIVE_ASSISTANT_ENABLED=false
EXECUTIVE_ASSISTANT_DAILY_LIMIT=30
EXECUTIVE_ASSISTANT_EVIDENCE_LIMIT=40
EXECUTIVE_ASSISTANT_MAX_OUTPUT_TOKENS=2000
EXECUTIVE_ASSISTANT_STALE_MINUTES=15
# EXECUTIVE_BOT_CEO_USERNAME=replace-exact-username
# EXECUTIVE_BOT_TELEGRAM_CHAT_ID=replace-private-positive-chat-id
# EXECUTIVE_BOT_SIGNING_SECRET=use-an-independent-32-byte-secret
EXECUTIVE_BOT_SIGNATURE_TTL_SECONDS=300
EXECUTIVE_BOT_DOWNLOAD_TTL_SECONDS=600
EXECUTIVE_BOT_MAX_BODY_BYTES=8192
EXECUTIVE_BOT_REPORT_MAX_ROWS=500
EXECUTIVE_BOT_DAILY_LIMIT=20
EXECUTIVE_BOT_ALERT_BATCH_SIZE=20
EXECUTIVE_BOT_ALERT_LEASE_SECONDS=300
EXECUTIVE_BOT_STALE_MINUTES=15

PROJECT_AGENT_ENABLED=false
PROJECT_AGENT_PROVIDER=disabled
PROJECT_AGENT_DEFAULT_MODEL=openai/gpt-oss-120b
PROJECT_AGENT_REASONING_EFFORT=medium
PROJECT_AGENT_TIMEOUT_SECONDS=45
PROJECT_AGENT_MAX_OUTPUT_TOKENS=1800
PROJECT_AGENT_MAX_TOTAL_TOKENS=16000
PROJECT_AGENT_MAX_STEPS=8
PROJECT_AGENT_MAX_SECONDS=180
PROJECT_AGENT_DAILY_LIMIT=10
PROJECT_AGENT_MAX_CONTEXT_CHARS=500
PROJECT_AGENT_MAX_TOOL_RESULT_BYTES=32768
PROJECT_AGENT_MAX_TOOL_RECORDS=50
PROJECT_AGENT_MAX_MEMORIES=5
PROJECT_AGENT_STALE_MINUTES=15
PROJECT_AGENT_PROPOSAL_TTL_HOURS=72
PROJECT_AGENT_N8N_ENABLED=false
# PROJECT_AGENT_N8N_SIGNING_SECRET=use-an-independent-32-byte-secret
PROJECT_AGENT_N8N_SIGNATURE_TTL_SECONDS=300
