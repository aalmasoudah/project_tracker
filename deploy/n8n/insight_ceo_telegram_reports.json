    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst event = $input.first().json;\nconst message = event.message || {};\nconst configuredChat = String($env.INSIGHT_TELEGRAM_CEO_CHAT_ID || '').trim();\nconst incomingChat = String(message.chat?.id ?? '');\nif (!configuredChat || incomingChat !== configuredChat) return [];\nconst command = String(message.text || '').trim().split(/\\s+/)[0].split('@')[0].toLowerCase();\nconst commands = { '/tasks': 'current_tasks', '/overdue': 'overdue_tasks', '/attendance': 'attendance' };\nif (command === '/help' || !commands[command]) {\n  return [{ json: { kind: 'help', text_ar: 'أوامر إنسايت بروجكتس:\\n/tasks - تقرير المهام الحالية\\n/overdue - تقرير المهام المتأخرة\\n/attendance - تقرير حضور المتدربين بالأسماء\\n/help - عرض هذه المساعدة' } }];\n}\nconst secret = String($env.INSIGHT_N8N_SIGNING_SECRET || '');\nconst baseUrl = String($env.INSIGHT_APP_BASE_URL || '').replace(/\\/$/, '');\nif (!secret || !baseUrl) throw new Error('Missing Insight integration configuration');\nconst path = '/integrations/n8n/telegram/reports/start/';\nconst body = JSON.stringify({ chat_id: configuredChat, report_type: commands[command], window_days: 30 });\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst nonce = crypto.randomBytes(24).toString('base64url');\nconst bodyHash = crypto.createHash('sha256').update(body, 'utf8').digest('hex');\nconst canonical = [timestamp, nonce, 'POST', path, bodyHash].join('\\n');\nconst signature = crypto.createHmac('sha256', secret).update(canonical, 'utf8').digest('hex');\nreturn [{ json: { kind: 'report', url: baseUrl + path, body, timestamp, nonce, signature } }];"
      },
