    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst response = $input.first().json;\nconst alerts = Array.isArray(response.alerts) ? response.alerts : [];\nif (!alerts.length) return [];\nconst configuredChat = String($env.INSIGHT_TELEGRAM_CEO_CHAT_ID || '').trim();\nconst secret = String($env.INSIGHT_N8N_SIGNING_SECRET || '');\nconst baseUrl = String($env.INSIGHT_APP_BASE_URL || '').replace(/\\/$/, '');\nif (!response.lease_token || !configuredChat || !secret || !baseUrl) throw new Error('Invalid critical alert claim response');\nconst path = '/integrations/n8n/telegram/alerts/acknowledge/';\nreturn alerts.map((alert) => {\n  const body = JSON.stringify({ chat_id: configuredChat, lease_token: String(response.lease_token), alert_ids: [String(alert.alert_id)] });\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  const nonce = crypto.randomBytes(24).toString('base64url');\n  const bodyHash = crypto.createHash('sha256').update(body, 'utf8').digest('hex');\n  const canonical = [timestamp, nonce, 'POST', path, bodyHash].join('\\n');\n  const signature = crypto.createHmac('sha256', secret).update(canonical, 'utf8').digest('hex');\n  return { json: { message_ar: String(alert.message_ar), url: baseUrl + path, body, timestamp, nonce, signature } };\n});"
      },
